# App
APP_ENV=development
APP_NAME=singular-api
APP_PORT=3001
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# Database (SQLAlchemy / Alembic)
# Local Docker: postgresql+psycopg://singular:singular@localhost:5432/singular
# Supabase: Project Settings → Database → Connection string (URI).
#   Use the SQLAlchemy driver prefix: postgresql+psycopg://...
#   Example (pooler):
#   postgresql+psycopg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# All app tables and Alembic version history live ONLY in DB_SCHEMA (never public).
DATABASE_URL=postgresql+psycopg://singular:singular@localhost:5432/singular
DB_SCHEMA=marketplace

# Supabase (API / Auth helpers — optional alongside direct Postgres)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Redis
REDIS_URL=redis://localhost:6379

# Auth JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Shipping (COP enteros)
SHIPPING_COST=12900
FREE_SHIPPING_THRESHOLD=120000

# Object storage (S3-compatible)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=singular-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Payments (wompi | mercadopago)
PAYMENT_PROVIDER=mercadopago
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
WOMPI_INTEGRITY_SECRET=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Email
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=Singular <noreply@sesingular.com>

# Admin bootstrap (seed)
ADMIN_EMAIL=admin@sesingular.com
ADMIN_PASSWORD=ChangeMeAdmin123!
SELLER_EMAIL=vendedor@sesingular.com
SELLER_PASSWORD=ChangeMeSeller123!
